# Supabase (project etbesmtdsjlmadaexvrv)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://etbesmtdsjlmadaexvrv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NextAuth (Google + email/password stay on NextAuth, not Supabase Auth)
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client used by NextAuth
GOOGLE_ID=your-google-oauth-id
GOOGLE_SECRET=your-google-oauth-secret

# Server-only key for Bot rules address search. Enable Places API (New),
# Geocoding API, and Maps Static API for this key. It is not the OAuth
# client above, and the browser never receives it. Leave it blank to enter
# coordinates by hand.
GOOGLE_MAPS_API_KEY=

# Admin Configuration
# An email is an admin when it is listed here or it ends in @sleepysquid.com.
# The check is case-insensitive. New accounts and every sign-in store role
# admin for those addresses, and the dashboard uses the same rule.
ADMIN_EMAILS=admin@sleepysquid.com

# Referral links shown in the dashboard. Same secret as sleepysquid.com.
# The link email uses the existing Resend sender: RESEND_API_KEY and
# optional RESEND_FROM_EMAIL. The address stays noreply@send.sleepysquid.com.
REFERRAL_PUBLIC_ORIGIN=https://sleepysquid.com
REFERRAL_TOKEN_SECRET=

# Stripe Connect for referral payouts. A restricted key is enough.
# Permissions: Connect accounts write, account links write, transfers write, balance read.
# Leave blank and payouts stay manual. Use a test key until you mean to pay real people.
STRIPE_CONNECT_SECRET_KEY=

# Google reCAPTCHA (for spam protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email (Mailgun) - Required for contact form notifications
MAILGUN_API_KEY=your-mailgun-api-key

# Stripe (for payments)
STRIPE_SECRET_KEY=your-stripe-secret-key

# Site Configuration
SITE_URL=https://drones.sleepysquid.com

# OpenAI (if using AI features)
OPENAI_API_KEY=your-openai-api-key

# SMTP Configuration (fallback if Mailgun not available)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
