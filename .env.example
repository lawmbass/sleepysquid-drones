# Supabase (project etbesmtdsjlmadaexvrv)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://etbesmtdsjlmadaexvrv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NextAuth (Google + email/password stay on NextAuth, not Supabase Auth)
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client used by NextAuth
GOOGLE_ID=your-google-oauth-id
GOOGLE_SECRET=your-google-oauth-secret

# Admin Configuration
# Every address here must also end in @sleepysquid.com. Any @sleepysquid.com
# address is treated as an admin for dashboard access; API admin routes still
# require the address to be listed here.
ADMIN_EMAILS=admin@sleepysquid.com

# Google reCAPTCHA (for spam protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email (Mailgun) - Required for contact form notifications
MAILGUN_API_KEY=your-mailgun-api-key

# Stripe (for payments)
STRIPE_SECRET_KEY=your-stripe-secret-key

# Site Configuration
SITE_URL=https://drones.sleepysquid.com

# OpenAI (if using AI features)
OPENAI_API_KEY=your-openai-api-key

# SMTP Configuration (fallback if Mailgun not available)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
